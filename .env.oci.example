# Set this to the VM's public IP using nip.io, for example 203-0-113-10.nip.io.
FENCECOACH_DOMAIN=YOUR-IP.nip.io

# Create a bcrypt hash with `docker run -it --rm caddy:2-alpine caddy hash-password`.
# Store the chosen password hash here, and keep this file private.
FENCECOACH_BASIC_AUTH_USER=coach
FENCECOACH_BASIC_AUTH_HASH=

# Reuse your existing provider keys; the default new core tries Groq, then Gemini.
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
