# Set this to the VM's public IP using nip.io, for example 203-0-113-10.nip.io.
FENCECOACH_DOMAIN=YOUR-IP.nip.io

# Create a Gemini API key and paste it here; keep this file private.
GEMINI_API_KEY=

# Optional: change the Gemini model without editing compose.oci.yaml.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
